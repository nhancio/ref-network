rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // User profile and strictly private imported contacts
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /contacts/{contactId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Opt-in public "Where I can intro you" profile (contains ONLY company names/counts, never contact PII)
    match /publicProfiles/{handle} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && handle.matches('^[a-z0-9][a-z0-9-]{1,30}[a-z0-9]$');
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // One-time private circle invite links (no list/enumeration)
    match /invites/{token} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.inviterUid == request.auth.uid;
      allow update: if signedIn()
        && (resource.data.inviterUid == request.auth.uid
          || (resource.data.usedBy == null && request.resource.data.usedBy == request.auth.uid));
      allow delete: if signedIn() && resource.data.inviterUid == request.auth.uid;
    }

    // Mutual circle connections (only members can read/write)
    match /connections/{pairId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members;
      allow update, delete: if signedIn() && request.auth.uid in resource.data.members;
    }

    // Warm introduction requests between two users
    match /introRequests/{reqId} {
      allow read: if signedIn()
        && (resource.data.requesterUid == request.auth.uid
          || resource.data.connectorUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.connectorUid != request.auth.uid;
      allow update: if signedIn()
        && (resource.data.requesterUid == request.auth.uid
          || resource.data.connectorUid == request.auth.uid);
      allow delete: if signedIn()
        && (resource.data.requesterUid == request.auth.uid
          || resource.data.connectorUid == request.auth.uid);
    }
  }
}
